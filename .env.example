# Copy this file to .env.local and fill in your key.
# Never commit .env.local - it's already gitignored.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=         # 省略可。既定 claude-sonnet-5、デモは claude-opus-5
LLM_PROVIDER=            # 省略可。anthropic | ollama。未指定ならキーの有無で自動
OLLAMA_MODEL=            # 省略可。既定 qwen3:8b
OLLAMA_BASE_URL=         # 省略可。既定 http://localhost:11434
