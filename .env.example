# Copy this file to .env.local and fill in your key.
# Never commit .env.local - it's already gitignored.

GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=            # 省略可。会話（generate / としお）のモデル。既定 gemini-3.6-flash
GEMINI_EXTRACT_MODEL=    # 省略可。返答文から主張を取り出すモデル。既定 gemini-3.5-flash-lite
DATA_DIR=                # 省略可。db.json の置き場所（既定: ./.data）
