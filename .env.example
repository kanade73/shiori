# Copy this file to .env.local and fill in your key.
# Never commit .env.local - it's already gitignored.

GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY_2=        # 省略可。2本目（先輩）のキー。1本目が無料枠の上限に達したらこちらに切り替え、こちらも尽きたら1本目に戻る。別アカウントで作ったキーであること
GEMINI_MODEL=            # 省略可。会話（generate / としお）のモデル。既定 gemini-3.5-flash-lite
EXTRACT_OLLAMA_MODEL=qwen3:8b
                         # 省略可。主張の取り出しを手元の Ollama で行うときのモデル名（`ollama list` の名前）。
                         # これがあれば EXTRACT_ENDPOINT より優先する
OLLAMA_HOST=             # 省略可。Ollama の URL。既定 http://localhost:11434
EXTRACT_ENDPOINT=        # 省略可。主張の取り出しを自前の LoRA 推論サーバ（ml/serve.py、例 http://localhost:8123）で行う
GEMINI_EXTRACT_MODEL=    # 省略可。上の2つがどちらも無いときは Gemini で取り出す。そのモデル。既定 gemini-3.1-flash-lite
                         # 選んだ経路が落ちていても別の経路には切り替えない（その発話の主張が記録されないだけ）
GEMINI_ROUTER_MODEL=     # 省略可。話題の切り替わりの判定役。既定 gemini-3.1-flash-lite（GEMINI_MODEL と別にすると無料枠を食い合わない）
GEMINI_EMBEDDING_MODEL=  # 省略可。外部資料のベクトル検索。既定 gemini-embedding-001

# --- Supabase（セッション・嘘・段落の埋め込みの置き場所）---------------------
# supabase.com で無料プロジェクトを作り、Settings → API から控える。
# service_role キーはサーバー専用。NEXT_PUBLIC_ には絶対に置かない
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# スキーマを流すときだけ使う（npm run db:push）。Connect → Session pooler の URI（ポート 5432）
# PostgREST の service_role キーでは DDL を流せないので、ここだけ Postgres に直接つなぐ
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# 初回は `npm run db:push` → `npm run db:check` → `npm run embed`
