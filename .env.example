# Copy this file to .env.local and fill in your key.
# Never commit .env.local - it's already gitignored.

GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=            # 省略可。会話（generate / としお）のモデル。既定 gemini-3.6-flash
GEMINI_EXTRACT_MODEL=    # 省略可。返答文から主張を取り出すモデル。既定 gemini-3.5-flash-lite
EXTRACT_ENDPOINT=        # 省略可。主張の取り出しを自前の推論サーバに向ける（例 http://localhost:8123）。
                         # 未設定なら Gemini。繋がらなければ Gemini に自動で切り替わる
GEMINI_ROUTER_MODEL=     # 省略可。話題の切り替わりの判定役。既定 gemini-3.1-flash-lite（GEMINI_MODEL と別にすると無料枠を食い合わない）
GEMINI_EMBEDDING_MODEL=  # 省略可。外部資料のベクトル検索。既定 gemini-embedding-001
DATA_DIR=                # 省略可。db.json とベクトルDB（vectors/）の置き場所（既定: ./.data）
